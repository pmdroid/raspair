# Cross-build vinyl-bridge-pi for Raspberry Pi 4 (aarch64 / arm64).
# Usage from apps/pi4-host:
#   docker build -f deploy/Dockerfile.cross -t vinyl-pi-cross .
#   docker run --rm -v "$PWD":/src -w /src vinyl-pi-cross
FROM rust:1-bookworm

RUN dpkg --add-architecture arm64 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      gcc-aarch64-linux-gnu \
      g++-aarch64-linux-gnu \
      libc6-dev-arm64-cross \
      libasound2-dev:arm64 \
      pkg-config \
 && rm -rf /var/lib/apt/lists/*

RUN rustup target add aarch64-unknown-linux-gnu

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc

WORKDIR /src
CMD ["bash", "-lc", "cargo build --release --target aarch64-unknown-linux-gnu --features alsa && mkdir -p dist && cp target/aarch64-unknown-linux-gnu/release/vinyl-bridge-pi dist/ && aarch64-linux-gnu-strip dist/vinyl-bridge-pi && ls -lh dist/vinyl-bridge-pi"]
