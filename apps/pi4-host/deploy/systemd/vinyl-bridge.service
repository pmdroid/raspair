# Raspberry Pi OS / systemd hosts. Written by `sudo vinyl-bridge-pi install`.
# Buildroot appliance uses busybox /etc/init.d/S99vinyl-bridge instead.
[Unit]
Description=Vinyl Audio Bridge (Pi host)
Documentation=https://github.com/pmdroid/raspair
After=network-online.target sound.target vinyl-bridge-helper.service
Wants=network-online.target vinyl-bridge-helper.service

[Service]
Type=simple
User=vinyl-bridge
Group=vinyl-bridge
SupplementaryGroups=audio
ExecStart=/usr/local/bin/vinyl-bridge-pi --config /etc/vinyl-bridge/config.toml
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info
StateDirectory=vinyl-bridge
StateDirectoryMode=0750
# Real-time-ish audio: allow higher priority without full RT privileges.
LimitRTPRIO=20
LimitMEMLOCK=infinity
# Capture + HTTP
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_NICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_NICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
