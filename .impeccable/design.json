  "narrative": {
    "northStar": "Listening room",
    "overview": "Warm paper colors, olive controls, and Manrope text frame the music. Fine borders separate tasks, while the retained opening in the waveform gives terracotta a specific audio meaning.\n\nThe interface keeps song information beside the controls that affect it. Geometric record sleeves identify tracks; compact labels and tabular timers support listening, recording, and review.",
    "keyCharacteristics": [
      "Flat paper-colored panels with fine borders.",
      "Olive actions and selected states.",
      "Terracotta audio boundaries and retained openings.",
      "Manrope headings, compact controls, and tabular timers."
    ],
    "rules": [
      {
        "name": "The audio color rule",
        "body": "Use olive for controls and the main waveform. Use terracotta for the retained opening and boundary markers.",
        "section": "colors"
      },
      {
        "name": "The stable timer rule",
        "body": "Use tabular numerals for elapsed time, playback position, and waveform labels.",
        "section": "typography"
      },
      {
        "name": "The flat panel rule",
        "body": "Separate panels with paper tones and fine borders. Reserve the soft shadow for the floating toast.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep playback and recording states visually distinct.",
      "Do retain the terracotta opening highlight and the geometric record sleeves.",
      "Do keep Review visible for songs awaiting review on phones.",
      "Do use the darker recording captions on the olive recording panel.",
      "Do preserve visible keyboard focus and reduced-motion behavior."
    ],
    "donts": [
      "Don't use shadows to separate ordinary panels.",
      "Don't turn the record-sleeve artwork into a rounded card.",
      "Don't hide an unreviewed song's action behind its status dot."
    ]
  }
}
